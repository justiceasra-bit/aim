	return {
		type = "toggle", id = key, label = label, detail = detail, group = group, icon = icon, color = color,
		get = function() return cfg[key] == true end,
		set = function(value)
			cfg[key] = value
			saved.features[key] = value
			touch()
		end,
	}
end

